{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "kittycord-badges",
    "main": "src/index.ts",
    "compatibility_date": "2026-01-01",
    "workers_dev": true,
    "observability": { "enabled": false },
    "vars": {
        // public, not a secret
        "DISCORD_CLIENT_ID": "1573869839762591885",
        "DISCORD_API": "https://discord.com/api/v10"
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "kittycord-badges",
            "database_id": "030d71d0-5bae-43dc-b557-aa7e32d162fa"
        }
    ],
    "ratelimits": [
        { "name": "RL_AUTH", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_WRITE", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
        { "name": "RL_READ", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } }
    ]
}
